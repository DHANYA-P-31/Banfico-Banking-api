{
  "info": {
    "name": "Our Bank API",
    "description": "Covers Weeks 1-4: customer/account/beneficiary/transaction CRUD, Keycloak token acquisition, and role-based access control testing (ADMIN/MAKER/CHECKER). Run the 'Auth - Get Tokens' folder first (or run the whole collection top to bottom) so later requests have valid tokens in the environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Get Tokens",
      "description": "Run these first. Each saves its access token into the environment (admin_token, maker_token, checker_token, viewer_token) for use by every other request.",
      "item": [
        {
          "name": "Get Admin Token (admin1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set('admin_token', body.access_token);",
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Received an access token', function () {",
                  "    pm.expect(body.access_token).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{client_id}}",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "admin1",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "Admin@123",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": [
                "{{keycloak_url}}"
              ],
              "path": [
                "realms",
                "{{realm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            }
          },
          "response": []
        },
